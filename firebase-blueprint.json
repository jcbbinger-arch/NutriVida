{
  "entities": {
    "user_profile": {
      "title": "UserProfile",
      "description": "Perfil clínico y metabólico del usuario",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "weightKg": { "type": "number" },
        "heightCm": { "type": "number" },
        "waistCircumferenceCm": { "type": "number" },
        "targetCalories": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name", "age", "weightKg", "heightCm"]
    },
    "tracking_entry": {
      "title": "TrackingEntry",
      "description": "Registro periódico de peso, cintura y pasos Garmin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "weightKg": { "type": "number" },
        "waistCircumferenceCm": { "type": "number" },
        "dailySteps": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "date", "weightKg", "waistCircumferenceCm"]
    },
    "outdoor_route": {
      "title": "OutdoorRoute",
      "description": "Registro de actividad Garmin (caminata, carrera, bicicleta o natación en piscina) compatible con estadísticas Garmin Connect",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fecha": { "type": "string", "description": "Fecha de la sesión en formato YYYY-MM-DD" },
        "nombre_ruta": { "type": "string", "description": "Nombre o etiqueta opcional de la ruta o piscina" },
        "tipo": { "type": "string", "enum": ["Caminata", "Bicicleta", "Piscina"] },
        "subtipo_garmin": { "type": "string", "description": "Subtipo original Garmin (Carrera, Cinta, Caminata, Ciclismo, Bici Indoor, Piscina)" },
        "distancia_km": { "type": "number" },
        "distancia_metros": { "type": "number", "description": "Distancia en metros (Natación en piscina)" },
        "longitud_piscina_m": { "type": "number", "description": "Longitud de la piscina en metros (ej. 25 o 50)" },
        "largos_totales": { "type": "number", "description": "Total de largos en piscina" },
        "swolf_medio": { "type": "number", "description": "Índice SWOLF medio de natación Garmin" },
        "brazadas_totales": { "type": "number", "description": "Brazadas totales en piscina" },
        "brazadas_por_largo": { "type": "number", "description": "Media de brazadas por largo" },
        "tiempo_minutos": { "type": "number" },
        "tiempo_formato": { "type": "string" },
        "tiempo_movimiento": { "type": "string" },
        "altitud_m": { "type": "number" },
        "altitud_min_m": { "type": "number" },
        "desnivel_positivo_m": { "type": "number" },
        "desnivel_negativo_m": { "type": "number" },
        "ritmo_min_km": { "type": "string" },
        "ritmo_medio_movimiento": { "type": "string" },
        "ritmo_optimo": { "type": "string" },
        "velocidad_kmh": { "type": "number" },
        "velocidad_media_movimiento": { "type": "number" },
        "velocidad_maxima_kmh": { "type": "number" },
        "esfuerzo_acumulado": { "type": "string" },
        "heart_rate_avg_bpm": { "type": "number" },
        "heart_rate_max_bpm": { "type": "number" },
        "training_effect_aerobico": { "type": "number" },
        "cadencia_media_ppm": { "type": "number" },
        "cadencia_max_ppm": { "type": "number" },
        "longitud_zancada_m": { "type": "number" },
        "calorias_totales": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "tipo", "distancia_km", "tiempo_minutos"]
    },
    "elliptical_session": {
      "title": "EllipticalSession",
      "description": "Sesión de ejercicio en máquina elíptica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fecha": { "type": "string", "description": "Fecha de la sesión en formato YYYY-MM-DD" },
        "tiempo_minutos": { "type": "number" },
        "tiempo_formato": { "type": "string" },
        "nivel_resistencia": { "type": "number" },
        "rpm_promedio": { "type": "number" },
        "calorias_estimadas": { "type": "number" },
        "zona_intensidad": { "type": "string" },
        "heart_rate_avg_bpm": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "tiempo_minutos", "nivel_resistencia"]
    },
    "strength_session": {
      "title": "StrengthSession",
      "description": "Registro de serie o entrenamiento de fuerza en casa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fecha": { "type": "string", "description": "Fecha del entrenamiento en formato YYYY-MM-DD" },
        "nombre_ejercicio": { "type": "string" },
        "series_completadas": { "type": "number" },
        "repeticiones_completadas": { "type": "number" },
        "repeticiones_objetivo": { "type": "number" },
        "cadencia_tempo": { "type": "string" },
        "tiempo_segundos": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "fecha", "nombre_ejercicio", "repeticiones_completadas"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user_profile",
      "description": "Perfil de usuario"
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": "tracking_entry",
      "description": "Histórico de peso y cintura"
    },
    "/users/{userId}/outdoor_routes/{routeId}": {
      "schema": "outdoor_route",
      "description": "Histórico de rutas exteriores"
    },
    "/users/{userId}/elliptical_sessions/{sessionId}": {
      "schema": "elliptical_session",
      "description": "Histórico de elíptica"
    },
    "/users/{userId}/strength_sessions/{sessionId}": {
      "schema": "strength_session",
      "description": "Histórico de entrenamientos de fuerza"
    }
  }
}
