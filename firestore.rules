rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGuestOrOwner(userId) {
      return isOwner(userId) || userId == 'juan_fitstudio_user';
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Secure user documents & private subcollections
    match /users/{userId} {
      allow read, write: if isGuestOrOwner(userId);

      match /measurements/{measurementId} {
        allow read, write: if isGuestOrOwner(userId);
      }

      match /outdoor_routes/{routeId} {
        allow read, write: if isGuestOrOwner(userId);
      }

      match /elliptical_sessions/{sessionId} {
        allow read, write: if isGuestOrOwner(userId);
      }
    }
  }
}
